# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# PyInstaller build/output (regenerierbar per "python -m PyInstaller build/shc_live_stats.spec")
build/shc_live_stats/
dist/

# release/ ist der aufgeraeumte Verteil-Ordner (Struktur + README + .lnk-
# Verknuepfung bleiben versioniert) - die exe-Kopien selbst sind nur ein
# Abzug von dist/, genauso regenerierbar, keine eigene Quelle.
release/bin/

# Claude Code lokaler Laufzeit-Zustand (maschinenspezifisch)
.claude/*.lock
.claude/settings.local.json

# Icon-Rohmaterial (nur lokal fuer Bearbeitung noetig, fertige Icons liegen in app/assets/icons)
assets_source/Pictures/
assets_source/tgx_units/
assets_source/Truppen und waren.png
assets_source/icons_cropped/

# Portable Config/Logo/Presets (siehe app/paths.py app_data_dir()) - liegt
# im Dev-Betrieb direkt im Projekt-Root, ist nutzerspezifisch und soll
# nicht versioniert werden (analog zu %APPDATA% vorher).
/config/

# OS
Thumbs.db
.DS_Store
